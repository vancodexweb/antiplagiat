# Скрипты, исполняемые внутри Linux-контейнеров, обязаны иметь LF —
# иначе на Windows (core.autocrlf=true) git при чекауте подставляет CRLF,
# шебанг превращается в "#!/bin/sh\r", и Docker падает с обманчивой
# ошибкой "exec ./entrypoint-api.sh: no such file or directory".
*.sh text eol=lf

# Остальные текстовые файлы — нормализуем построчные окончания, чтобы не
# зависеть от локальной настройки autocrlf у каждого разработчика.
* text=auto eol=lf
