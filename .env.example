# =============================================================================
# Antiplagiat — переменные окружения (пример). Скопируйте в .env и при
# необходимости отредактируйте значения перед запуском docker compose.
# =============================================================================

# --- Общие ---
NODE_ENV=production
TZ=Europe/Moscow

# --- API (NestJS) ---
API_PORT=3000
# Максимальный размер загружаемого файла, в мегабайтах
MAX_FILE_SIZE_MB=25
# Норматив символов (с пробелами) на одну "страницу" по умолчанию.
# Реальное значение хранится в БД (SystemConfig) и редактируется через
# GET/PUT /api/config/page-norm — эта переменная используется только для
# первичного посева значения при первом запуске.
DEFAULT_PAGE_NORM_CHARS=1800
# Размер шингла (окно, слов) для детекции точных заимствований (раздел 3.2)
SHINGLE_SIZE=5
# Порог косинусной близости эмбеддингов предложений, начиная с которого
# предложение считается перефразированным заимствованием (раздел 3.2)
PARAPHRASE_SIMILARITY_THRESHOLD=0.75
# Сколько самых частых значимых слов учитывать при расчёте заспамленности (3.6)
SPAM_TOP_N_WORDS=10
# Порог aiProbability (0..1), начиная с которого выставляется aiVerdict=true (3.3)
AI_VERDICT_THRESHOLD=0.6

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=antiplagiat
POSTGRES_USER=antiplagiat
POSTGRES_PASSWORD=antiplagiat
DATABASE_URL=postgresql://antiplagiat:antiplagiat@postgres:5432/antiplagiat?schema=public

# --- Redis (кэш по contentHash, LSH-бакеты) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- RabbitMQ (очередь задач анализа) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=antiplagiat
RABBITMQ_PASSWORD=antiplagiat
RABBITMQ_URL=amqp://antiplagiat:antiplagiat@rabbitmq:5672
RABBITMQ_QUEUE=documents_analysis
RABBITMQ_DLQ=documents_analysis_dlq
RABBITMQ_MAX_RETRIES=3

# --- LanguageTool (грамматика и орфография) ---
LANGUAGETOOL_URL=http://languagetool:8010
LANGUAGETOOL_PORT=8010

# --- nlp-service (Python/FastAPI) ---
NLP_SERVICE_URL=http://nlp-service:8001
NLP_SERVICE_PORT=8001
# Многоязычная модель эмбеддингов предложений (перефразирование)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Тяжёлая опциональная фича — перплексия через языковую модель (раздел 3.3)
ENABLE_PERPLEXITY_FEATURE=false
# OCR для сканированных документов (раздел 3.9)
ENABLE_OCR=true
OCR_LANGUAGES=rus+eng

# --- Внешняя проверка по интернету (раздел 3.2) ---
# Полностью опционально: без ключей ExternalSearchProvider работает как
# заглушка (см. документацию/README) и не блокирует локальный запуск.
ENABLE_EXTERNAL_SEARCH=false
EXTERNAL_SEARCH_PROVIDER=none
# Сколько "редких" (не найденных в локальном корпусе) шинглов проверять
# через внешнюю поисковую систему за один документ
EXTERNAL_SEARCH_SAMPLE_SIZE=5
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# --- Rate limiting (@nestjs/throttler) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
