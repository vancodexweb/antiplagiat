{
  "name": "antiplagiat-server",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS-кодовая база сервисов api и worker сервиса проверки текста на оригинальность и признаки ИИ",
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/main-worker.js",
    "start:api:dev": "nest start --watch",
    "start:worker:dev": "nest start --entryFile main-worker --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "file-type": "^22.1.0",
    "franc": "^6.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.9.2"
  }
}
